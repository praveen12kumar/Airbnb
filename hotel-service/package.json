{
    "name": "server",
    "version": "1.0.0",
    "description": "Edtech platform",
    "main": "dist/index.js",
    "scripts": {
        "build": "npx tsc",
        "lint": "eslint --fix .",
        "format": "prettier --write .",
        "predev": "npm run lint && npm run format",
        "prestart": "npm run build",
        "watch": "npx tsc -w",
        "start": "npx nodemon dist/index.js",
        "dev": "npx concurrently \"npm run watch\" \"npm start\""
    },
    "author": "Praveen Kumar",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "concurrently": "^9.2.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.22.3",
        "nodemon": "^3.1.14",
        "otp-generator": "^4.0.1",
        "sequelize": "^6.37.8",
        "uuid": "^14.0.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.15.3",
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.59.3",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "jiti": "^2.7.0",
        "prettier": "^3.8.3",
        "sequelize-cli": "^6.6.5",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.8.3"
    }
}
